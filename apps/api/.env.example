# Copy to apps/api/.env; run API/worker commands from apps/api.
NODE_ENV=development
PORT=5000
# Database and Redis: localhost services from docker-compose.test.yml (disposable only).
DATABASE_URL=postgresql://supportiq:isolated-test-only@127.0.0.1:55441/supportiq_demo?schema=public
REDIS_URL=redis://127.0.0.1:55440
# Auth: generate a random secret locally; never use this placeholder in deployment.
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
# HTTP and Socket.IO use the same comma-separated exact origin allowlist.
CLIENT_URL=http://localhost:5173
# Storage: filesystem is local-only; production requires s3 and HTTPS endpoints.
KNOWLEDGE_STORAGE=filesystem
KNOWLEDGE_STORAGE_ROOT=./data/knowledge
KNOWLEDGE_MAX_BYTES=10485760
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=false
# S3_BUCKET=your-private-bucket
# S3_ENDPOINT=https://your-provider-endpoint
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN: SDK credential chain
# AI providers: optional. No key means lexical retrieval and safe template fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Worker
INGESTION_LEASE_MS=120000
INGESTION_MAX_ATTEMPTS=3
INGESTION_EMBEDDING_BATCH=4
INGESTION_REQUIRE_SEMANTIC=false
# Public demo account stays read-only. Reset is never enabled by default.
DEMO_READONLY_EMAILS=demo.owner@supportiq.app
# Set SUPPORTIQ_DEMO_RESET=ERASE_LOCAL_DEMO only for an intentional local reset.
# Tests use .env.test and SUPPORTIQ_TEST_PGVECTOR/REDIS/S3 flags; see docs/testing.md.
