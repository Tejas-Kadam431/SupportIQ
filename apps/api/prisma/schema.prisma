generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  AGENT
  CUSTOMER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum KnowledgeDocumentStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum KnowledgeVersionStatus {
  UPLOADED
  PROCESSING
  READY
  PUBLISHED
  SUPERSEDED
  FAILED
}

enum ActivityType {
  KNOWLEDGE_VERSION_EVENT
  TICKET_CREATED
  TICKET_ASSIGNED
  STATUS_CHANGED
  MESSAGE_SENT
  INTERNAL_NOTE_ADDED
  AI_REPLY_GENERATED
  DOCUMENT_UPLOADED
}

enum CopilotDisposition {
  ACCEPTED
  EDITED
  REJECTED
}

enum CopilotFailureReason {
  WRONG_KNOWLEDGE
  MISSING_CUSTOMER_CONTEXT
  INSUFFICIENT_KB
  IRRELEVANT_EVIDENCE
  INCORRECT_RECOMMENDATION
  INCOMPLETE_RESPONSE
  BAD_TONE
  UNSUPPORTED_CLAIM
  OTHER
}

model User {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  passwordHash String
  avatarUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedOrganizations Organization[]       @relation("OrganizationOwner")
  memberships        OrganizationMember[]
  refreshTokens      RefreshToken[]
  refreshSessions    RefreshSession[]

  customerTickets            Ticket[]            @relation("TicketCustomer")
  assignedTickets            Ticket[]            @relation("TicketAssignee")
  ticketMessages             TicketMessage[]     @relation("TicketMessageSender")
  internalNotes              InternalNote[]      @relation("InternalNoteAuthor")
  activityLogs               ActivityLog[]       @relation("ActivityActor")
  uploadedKnowledgeDocuments KnowledgeDocument[] @relation("KnowledgeDocumentUploader")
  copilotRuns                CopilotRun[]        @relation("CopilotRunTrigger")
  copilotEvaluations         CopilotEvaluation[] @relation("CopilotEvaluationActor")

  @@index([email])
}

model RefreshToken {
  id         String          @id @default(cuid())
  userId     String
  tokenHash  String
  expiresAt  DateTime
  revokedAt  DateTime?
  consumedAt DateTime?
  // Null only for pre-session credentials, which require login again.
  sessionId  String?
  session    RefreshSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([sessionId])
}

enum RefreshRevokeReason {
  LOGOUT
  REUSE_DETECTED
}

model RefreshSession {
  id           String               @id @default(cuid())
  userId       String
  createdAt    DateTime             @default(now())
  lastUsedAt   DateTime             @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  revokeReason RefreshRevokeReason?
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens       RefreshToken[]

  @@index([userId])
}

model Organization {
  evaluationSuites      EvaluationSuite[]
  evaluationExperiments EvaluationExperiment[]
  knowledgeIssues       KnowledgeIssue[]

  id      String @id @default(cuid())
  name    String
  slug    String @unique
  ownerId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User                 @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members OrganizationMember[]

  tickets            Ticket[]
  activityLogs       ActivityLog[]
  knowledgeDocuments KnowledgeDocument[]
  knowledgeChunks    KnowledgeChunk[]
  copilotRuns        CopilotRun[]

  @@index([ownerId])
  @@index([slug])
}

model OrganizationMember {
  knowledgeIssues KnowledgeIssue[]

  id             String @id @default(cuid())
  organizationId String
  userId         String
  role           Role

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([role])
}

model Ticket {
  id             String  @id @default(cuid())
  organizationId String
  customerId     String
  assigneeId     String?

  title       String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)

  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     User         @relation("TicketCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  assignee     User?        @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  messages      TicketMessage[]
  internalNotes InternalNote[]
  activityLogs  ActivityLog[]
  copilotRuns   CopilotRun[]

  @@index([organizationId])
  @@index([customerId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model TicketMessage {
  copilotEvaluation CopilotEvaluation?
  id                String             @id @default(cuid())
  ticketId          String
  senderId          String
  body              String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User   @relation("TicketMessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@index([senderId])
  @@index([createdAt])
}

model InternalNote {
  id       String @id @default(cuid())
  ticketId String
  authorId String
  body     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation("InternalNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@index([authorId])
  @@index([createdAt])
}

model ActivityLog {
  id             String  @id @default(cuid())
  organizationId String
  ticketId       String?
  actorId        String?

  type     ActivityType
  message  String
  metadata Json?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       Ticket?      @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  actor        User?        @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([ticketId])
  @@index([actorId])
  @@index([type])
  @@index([createdAt])
}

model KnowledgeDocument {
  id             String @id @default(cuid())
  organizationId String
  uploadedById   String

  fileName     String
  originalName String
  mimeType     String
  sizeBytes    Int
  storagePath  String

  status                KnowledgeDocumentStatus @default(UPLOADED)
  errorMessage          String?
  semanticIndexedChunks Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation("KnowledgeDocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  archivedAt                DateTime?
  nextVersionNumber         Int                        @default(1)
  currentPublishedVersionId String?                    @unique
  currentPublishedVersion   KnowledgeDocumentVersion?  @relation("CurrentKnowledge", fields: [currentPublishedVersionId], references: [id], onDelete: NoAction)
  versions                  KnowledgeDocumentVersion[] @relation("DocumentVersions")
  chunks                    KnowledgeChunk[]

  @@index([organizationId])
  @@index([uploadedById])
  @@index([status])
  @@index([createdAt])
}

model KnowledgeDocumentVersion {
  evaluationScopes EvaluationScopeVersion[]
  candidateIssues  KnowledgeIssue[]
  issueSources     KnowledgeIssueSource[]

  id                    String                   @id @default(cuid())
  documentId            String
  versionNumber         Int
  status                KnowledgeVersionStatus   @default(UPLOADED)
  originalName          String
  mimeType              String
  sizeBytes             Int
  storageRef            String
  sourceHash            String?
  contentHash           String?
  extractedText         String?
  createdByIdentity     String
  createdAt             DateTime                 @default(now())
  publishedAt           DateTime?
  semanticIndexedChunks Int?
  embeddingModel        String?
  errorMessage          String?
  processingToken       String?
  leaseUntil            DateTime?
  document              KnowledgeDocument        @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  currentFor            KnowledgeDocument?       @relation("CurrentKnowledge")
  chunks                KnowledgeChunk[]
  sources               CopilotKnowledgeSource[]

  @@unique([documentId, versionNumber])
  @@index([documentId, status])
}

model KnowledgeChunk {
  documentVersionId String
  contentHash       String
  version           KnowledgeDocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  sources           CopilotKnowledgeSource[]
  id                String                   @id @default(cuid())
  documentId        String
  organizationId    String

  content    String
  chunkIndex Int
  tokenCount Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  document     KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([documentVersionId, chunkIndex])
  @@index([documentVersionId])
  @@index([documentId])
  @@index([organizationId])
  @@index([createdAt])
}

model CopilotKnowledgeSource {
  copilotRunId      String
  documentVersionId String
  chunkId           String
  run               CopilotRun               @relation(fields: [copilotRunId], references: [id], onDelete: Cascade)
  version           KnowledgeDocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: NoAction)
  chunk             KnowledgeChunk           @relation(fields: [chunkId], references: [id], onDelete: NoAction)

  @@id([copilotRunId, chunkId])
  @@index([documentVersionId])
  @@index([chunkId])
}

model CopilotRun {
  evaluationCases EvaluationCase[]
  knowledgeSignal KnowledgeIssueSignal?

  knowledgeSources      CopilotKnowledgeSource[]
  triggeredByIdentity   String?
  provenanceVersion     Int                      @default(0)
  status                String                   @default("LEGACY")
  model                 String?
  promptVersion         String?
  retrievalVersion      String?
  evidencePolicyVersion String?
  generationPath        String?
  generationDurationMs  Int?
  startedAt             DateTime?
  completedAt           DateTime?
  contextFingerprint    String?
  inputSnapshot         Json?
  promptSnapshot        Json?
  outputSnapshot        Json?
  generationConfig      Json?
  providerMetadata      Json?
  id                    String                   @id @default(cuid())
  organizationId        String
  ticketId              String
  triggeredById         String?

  provider   String
  confidence String
  tone       String

  topic              String
  issueSummary       String
  missingInformation Json
  recommendedAction  String
  suggestedReply     String?
  abstained          Boolean @default(false)

  searchQuery String
  searchMode  String
  sourceCount Int
  sources     Json
  warnings    Json

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  triggeredBy  User?        @relation("CopilotRunTrigger", fields: [triggeredById], references: [id], onDelete: SetNull)

  evaluation CopilotEvaluation?

  @@index([organizationId, createdAt])
  @@index([organizationId])
  @@index([ticketId])
  @@index([triggeredById])
  @@index([topic])
  @@index([createdAt])
}

model CopilotEvaluation {
  integrityVersion  Int            @default(0)
  messageId         String?        @unique
  message           TicketMessage? @relation(fields: [messageId], references: [id], onDelete: NoAction)
  originalReply     String?
  evaluatorIdentity String?
  originalCharCount Int?
  finalCharCount    Int?
  id                String         @id @default(cuid())
  copilotRunId      String         @unique
  evaluatorId       String?

  disposition  CopilotDisposition
  reason       CopilotFailureReason?
  finalMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  copilotRun CopilotRun @relation(fields: [copilotRunId], references: [id], onDelete: Cascade)
  evaluator  User?      @relation("CopilotEvaluationActor", fields: [evaluatorId], references: [id], onDelete: SetNull)

  @@index([evaluatorId])
  @@index([disposition])
  @@index([reason])
  @@index([createdAt])
}

enum KnowledgeIssueStatus {
  DETECTED
  REVIEWING
  FIX_PROPOSED
  PUBLISHED
  VERIFIED
  DISMISSED
}

model KnowledgeIssue {
  evaluationSuites    EvaluationSuite[]
  id                  String                    @id @default(cuid())
  organizationId      String
  groupingKey         String
  normalizedTopic     String
  title               String
  reason              String
  status              KnowledgeIssueStatus      @default(DETECTED)
  revision            Int                       @default(0)
  assigneeMemberId    String?
  candidateVersionId  String?
  fixNote             String?
  publishedAt         DateTime?
  dismissalReason     String?
  dismissedAt         DateTime?
  dismissedByIdentity String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee            OrganizationMember?       @relation(fields: [assigneeMemberId], references: [id], onDelete: SetNull)
  candidateVersion    KnowledgeDocumentVersion? @relation(fields: [candidateVersionId], references: [id], onDelete: NoAction)
  signals             KnowledgeIssueSignal[]
  history             KnowledgeIssueHistory[]

  @@unique([organizationId, groupingKey])
  @@index([organizationId, status, updatedAt])
  @@index([assigneeMemberId])
  @@index([candidateVersionId])
}

model KnowledgeIssueSignal {
  id                String                 @id @default(cuid())
  issueId           String
  copilotRunId      String                 @unique
  reason            String
  classifierVersion String
  occurredAt        DateTime
  createdAt         DateTime               @default(now())
  issue             KnowledgeIssue         @relation(fields: [issueId], references: [id], onDelete: Cascade)
  run               CopilotRun             @relation(fields: [copilotRunId], references: [id], onDelete: Cascade)
  sources           KnowledgeIssueSource[]

  @@index([issueId, occurredAt])
}

model KnowledgeIssueSource {
  signalId          String
  documentVersionId String
  attributed        Boolean                  @default(false)
  signal            KnowledgeIssueSignal     @relation(fields: [signalId], references: [id], onDelete: Cascade)
  version           KnowledgeDocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: NoAction)

  @@id([signalId, documentVersionId])
  @@index([documentVersionId])
}

model KnowledgeIssueHistory {
  id            String         @id @default(cuid())
  issueId       String
  actorIdentity String?
  event         String
  metadata      Json
  createdAt     DateTime       @default(now())
  issue         KnowledgeIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId, createdAt])
}

enum ExperimentStatus {
  DRAFT
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ExperimentPurpose {
  PRE_PUBLICATION
  POST_PUBLICATION_VERIFICATION
  GENERAL_COMPARISON
}

enum ReplayClassification {
  IMPROVED
  UNCHANGED
  REGRESSED
  INCONCLUSIVE
  ERROR
}

model EvaluationSuite {
  id             String                 @id @default(cuid())
  organizationId String
  issueId        String?
  name           String
  actorIdentity  String
  createdAt      DateTime               @default(now())
  sampling       Json
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  issue          KnowledgeIssue?        @relation(fields: [issueId], references: [id], onDelete: NoAction)
  cases          EvaluationCase[]
  experiments    EvaluationExperiment[]

  @@index([organizationId, createdAt])
  @@index([issueId])
}

model EvaluationCase {
  id                     String             @id @default(cuid())
  suiteId                String
  historicalCopilotRunId String
  kind                   String
  input                  Json
  baseline               Json
  createdAt              DateTime           @default(now())
  suite                  EvaluationSuite    @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  run                    CopilotRun         @relation(fields: [historicalCopilotRunId], references: [id], onDelete: NoAction)
  results                EvaluationResult[]

  @@unique([suiteId, historicalCopilotRunId])
  @@index([historicalCopilotRunId])
}

model EvaluationExperiment {
  id             String                   @id @default(cuid())
  organizationId String
  suiteId        String
  name           String
  actorIdentity  String
  purpose        ExperimentPurpose
  status         ExperimentStatus         @default(DRAFT)
  configuration  Json
  summary        Json
  errorCode      String?
  createdAt      DateTime                 @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  suite          EvaluationSuite          @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  scope          EvaluationScopeVersion[]
  results        EvaluationResult[]

  @@index([organizationId, status, createdAt])
  @@index([organizationId, purpose, createdAt])
  @@index([suiteId])
}

model EvaluationScopeVersion {
  experimentId      String
  documentVersionId String
  override          Boolean
  contentHash       String
  experiment        EvaluationExperiment     @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  version           KnowledgeDocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: NoAction)

  @@id([experimentId, documentVersionId])
  @@index([documentVersionId])
}

model EvaluationResult {
  id             String               @id @default(cuid())
  experimentId   String
  caseId         String
  classification ReplayClassification
  candidate      Json
  comparison     Json
  durationMs     Int
  createdAt      DateTime             @default(now())
  experiment     EvaluationExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  case           EvaluationCase       @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([experimentId, caseId])
  @@index([experimentId, classification])
}
